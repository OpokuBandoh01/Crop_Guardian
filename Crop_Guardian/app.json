{
  "expo": {
    "name": "FarmDoc",
    "slug": "Crop_Guardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/farmDocLogo.png",
    "scheme": "farmdoc",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.becewassce.prep",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/farmDocLogo.png",
        "backgroundColor": "#FFFFE7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.kojoameyaw519.Crop_Guardian",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/farmDocLogo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/farmDocLogo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFE7",
          "dark": {
            "backgroundColor": "#FFFFE7"
          }
        }
      ],
      "expo-font",
      "expo-audio",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8c8e9389-40a5-4d39-ad1c-d464169927c0"
      },
      "firebaseServiceAccount": "file:./chief-a750e-firebase-adminsdk-fbsvc-1368c9afe2.json"
    },
    "owner": "kojoameyaw519"
  }
}
